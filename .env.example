# ==================================================================
# WhiskyFest Contracts — Environment Variables
# Copy this file to .env.local for local dev; set these in Vercel
# for production.
# ==================================================================

# --- Portal hostnames (same Vercel deployment, multiple domains) ---
# NYWE vendor licenses portal — clean URLs at /, /roster, /contracts, /accounting
NYWE_PORTAL_HOST=nywecontracts.winespectator.com
# Optional explicit origins for email deep links (defaults to https://{host})
# NYWE_PORTAL_ORIGIN=https://nywecontracts.winespectator.com
# WHISKYFEST_PORTAL_HOST=wacontracts.whiskyadvocate.com
# WHISKYFEST_PORTAL_ORIGIN=https://wacontracts.whiskyadvocate.com

# --- NextAuth ---
# Run: openssl rand -base64 32
AUTH_SECRET=
# Local dev only — do NOT set AUTH_URL or NEXTAUTH_URL on Vercel when using two domains
# (nywecontracts.winespectator.com + wacontracts.whiskyadvocate.com). Auth.js uses trustHost.
# For local dev:
NEXTAUTH_URL=http://localhost:3000

# Display timezone for timestamps and agreement date merge tokens (IANA, e.g. America/New_York)
NEXT_PUBLIC_DISPLAY_TIMEZONE=America/New_York

# Comma-separated emails to omit from the home dashboard (test logins / sandbox sales reps).
# DASHBOARD_EXCLUDED_ACCOUNT_EMAILS=

# --- Google OAuth (for login) ---
# console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID, web application
# Authorized redirect URIs (add both production domains):
#   {NEXTAUTH_URL}/api/auth/callback/google
#   https://nywecontracts.winespectator.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase ---
# supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon key — safe for browser; used for Realtime broadcast subscriptions (Phase 3). Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Google Places address autocomplete on "New contract" (Maps JavaScript API + Places API)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Drive/Docs (for PDF generation) ---
# Create a service account at console.cloud.google.com
# Enable Drive API + Docs API
# Download JSON key, then base64-encode it:
#   base64 -i service-account-key.json | pbcopy    (macOS)
#   base64 service-account-key.json                 (Linux)
# Share the template Doc and Drafts/Signed folders with the service
# account's email (found in the JSON client_email field)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Google Sheets — contract lifecycle tracker (same service account needs Editor on the sheet)
SHEETS_TRACKER_ID=1jGTlDGVlOymA1Z0b8JRNzWamuOEuG3saquW9MVDn-6U
SHEETS_TRACKER_TAB=Sheet1

# Google Sheets — accounting billed exhibitor exports (WhiskyFest + NYWE)
# Service account needs Editor on the folder and/or spreadsheets.
# GOOGLE_BILLED_EXPORT_FOLDER_ID=
# SHEETS_BILLED_WHISKYFEST_ID=
# SHEETS_BILLED_NYWE_ID=
# SHEETS_BILLED_TAB=Billed Exhibitors

# Booth contract template Google Doc ID (from the URL)
GOOGLE_TEMPLATE_DOC_ID=1W5wJvMPZUlHfIkZ7yscYBFQrVATzrvwNhHTNrupeQP4

# Sponsorship-only template (no booth row). Share with the same service account.
# Falls back to GOOGLE_TEMPLATE_DOC_ID if unset.
# GOOGLE_SPONSORSHIP_TEMPLATE_DOC_ID=

# Optional: Shared Drive folder ID that contains the template + Drafts/Signed subfolders.
# If unset, inferred from GOOGLE_TEMPLATE_DOC_ID parent folder (cleanup route).
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Drive folder IDs
GOOGLE_DRAFTS_FOLDER_ID=1gZYxZvsR9VJuNTVOKBxPdFnkAquLmMGT
GOOGLE_SIGNED_FOLDER_ID=1scV2YZ963-Y9M2RAN876q3J1t_PAz_Ew

# --- DocuSign (Phase 2 — leave blank for Phase 1) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_URL=https://account-d.docusign.com
DOCUSIGN_RSA_PRIVATE_KEY=

# Countersignature uses each event's configured signatory:
# - events.shanken_signatory_name
# - events.shanken_signatory_email

# Optional: DocuSign Connect HMAC (must match Connect configuration)
DOCUSIGN_CONNECT_HMAC_SECRET=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
# WhiskyFest internal notifications (default: wfcontracts@whiskyadvocate.com)
WHISKYFEST_FROM_EMAIL=wfcontracts@whiskyadvocate.com
WHISKYFEST_FROM_NAME=WhiskyFest Contracts
# Wine Spectator / NYWE — must be verified in SendGrid; used for NYWE contract notifications
WINE_SPECTATOR_FROM_EMAIL=nywecontracts@winespectator.com
WINE_SPECTATOR_FROM_NAME=NYWE Contracts
# Comma-separated AP/billing addresses (TO on executed handoff). Legacy ACCOUNTING_EMAIL is still read if this is unset.
ACCOUNTING_EMAILS=accountsreceivable@mshanken.com,dbixler@mshanken.com,aanderson@mshanken.com
# NYWE internal notification routing (SendGrid — not DocuSign / not accounting handoff)
# Ops inbox: invoice sent/paid, void visibility. Countersigner is always excluded from these.
NYWE_OPS_NOTIFICATION_EMAILS=dbixler@mshanken.com,aanderson@mshanken.com
# Who receives "review needed" when a NYWE license PDF is generated (default: event countersigner).
# NYWE_EVENTS_REVIEW_EMAILS=snolan@mshanken.com
# Extra addresses to never CC on internal workflow mail (comma-separated).
# NOTIFICATION_EXCLUDED_EMAILS=
# Legacy alias — NYWE_OPS_NOTIFICATION_EMAILS takes precedence when both are set.
# EVENTS_MANAGED_INVOICE_NOTIFICATION_EMAILS=
# WhiskyFest accounting handoff FROM only (NYWE uses WINE_SPECTATOR_FROM_EMAIL instead)
ACCOUNTING_FROM_EMAIL=contracts@mshanken.com
# DocuSign brand ids — control exhibitor-facing signing email sender/logo (create brands in DocuSign admin)
# DOCUSIGN_BRAND_ID_WHISKYFEST=
# DOCUSIGN_BRAND_ID_WINE_SPECTATOR=
